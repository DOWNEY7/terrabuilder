{
  "name": "@terrabuilder/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "rimraf": "^5.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9"
  }
}
