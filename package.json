{
  "name": "terrabuilder",
  "private": true,
  "version": "0.1.0",
  "description": "Visual Infrastructure Compiler — drag-and-drop Terraform/CloudFormation/Bicep builder",
  "scripts": {
    "dev": "turbo run dev --filter=@terrabuilder/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "type-check": "turbo run type-check",
    "lint": "turbo run lint",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
